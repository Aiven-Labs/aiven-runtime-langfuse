# WEB ONLY
NEXTAUTH_SECRET=
LANGFUSE_INIT_ORG_ID=runtime-demo-org
LANGFUSE_INIT_ORG_NAME=Runtime Demo
LANGFUSE_INIT_PROJECT_ID=runtime-demo-project
