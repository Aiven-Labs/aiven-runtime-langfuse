VALKEY_URL=
AIVEN_CA_CERT_BASE64=
SALT=
ENCRYPTION_KEY=
NEXTAUTH_URL=
CLICKHOUSE_URL=
CLICKHOUSE_MIGRATION_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=langfuse
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
