# Local Compose. Generate each secret independently with openssl rand -hex 32.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=

# An existing private S3 bucket is required even for local Compose.
# Cloudflare R2 example; use its S3 API endpoint, not an r2.dev public URL.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
